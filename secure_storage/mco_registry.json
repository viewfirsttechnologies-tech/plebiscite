import json
import os

# Generate 1000 sample MCO entries for the template registry
sample_registry = []
first_names = ["JAMES", "SARAH", "MIGUEL", "ANNA", "JOHN", "MARIA", "DAVID", "ELENA", "ROBERT", "LISA"]
last_names = ["REED", "CONNOR", "SANTOS", "CRUZ", "SMITH", "GARCIA", "JOHNSON", "BROWN", "DAVIS", "MILLER"]

for i in range(1, 1001):
    mco_id = f"{i:05d}"
    # Create deterministic variety for names
    f_name = first_names[(i * 7) % len(first_names)]
    l_name = last_names[(i * 13) % len(last_names)]
    name = f"{f_name} {l_name} {i}"
    sample_registry.append({
        "id": mco_id,
        "name": name
    })

base_dir = "socoteco_plebiscite"
registry_path = os.path.join(base_dir, "secure_storage", "mco_registry.example.json")

with open(registry_path, "w") as f:
    json.dump(sample_registry, f, indent=4)

print(f"Successfully generated {len(sample_registry)} MCO sample records in {registry_path}")